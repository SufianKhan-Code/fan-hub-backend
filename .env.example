PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fanhubplus
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Local forgot-password testing only. Production never exposes reset tokens.
ALLOW_DEV_RESET_TOKEN=true

# Seed/demo users. Keep real production values in hosting environment variables, not source control.
SEED_ADMIN_EMAIL=admin@fanhubplus.demo
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=user@fanhubplus.demo
SEED_USER_PASSWORD=

# Safety switch for server/seed/seed.js. Leave false in production.
ALLOW_DESTRUCTIVE_SEED=false
